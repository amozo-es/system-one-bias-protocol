# Copy to `.env` and fill in only what you use. Loaded automatically by
# src/models.py (KEY=VALUE lines); the cluster evaluator reads these straight
# from the environment instead. Never commit the real .env.

# --- hosted models (Jev audit route, OpenRouter) ---
OPENROUTER_API_KEY=

# --- Together.ai baselines (Qwen3.5-9B, gpt-oss-20B chat) ---
TOGETHER_API_KEY=

# --- local serving endpoints (optional; defaults shown) ---
# OLLAMA_BASE_URL=http://localhost:1234
# VON_BASE_URL=http://localhost:8000

# --- data and cache locations (also read directly from the environment) ---
# DATASETS_DIR=datasets
# HF_HOME=
# MODELS_DIR=models
